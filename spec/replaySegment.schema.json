        "voiceFrames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tick": {
                "$ref": "#/definitions/replaySegment/properties/frames/items/properties/tick"
              },
              "playerId": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/replaySegment/properties/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "codec": {
                "type": "string",
                "const": "opus"
              },
              "dataBase64": {
                "type": "string"
              },
              "producerFields": {
                "$ref": "#/definitions/replaySegment/properties/frames/items/properties/players/items/properties/producerFields"
              }
            },
            "required": [
              "tick",
              "playerId",
              "durationSeconds",
              "codec",
              "dataBase64",
              "producerFields"
            ],
            "additionalProperties": false
          }
        },
        "producerFields": {
          "$ref": "#/definitions/replaySegment/properties/frames/items/properties/players/items/properties/producerFields"
        }
      },
      "required": [
        "id",
        "frames",
        "preparationFrames",
        "projectiles",
        "smokeFrames",
        "fireFrames",
        "voiceFrames",
        "producerFields"
      ],
      "additionalProperties": false
    }
