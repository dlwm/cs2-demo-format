                    "playerId": {
                      "$ref": "#/definitions/replaySegment/properties/id"
                    },
                    "position": {
                      "anyOf": [
                        {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "yaw": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "pitch": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "T",
                        "CT",
                        "spectator",
                        "unknown"
                      ]
                    },
                    "health": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "alive": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "weapon": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "inventory": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "armor": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "helmet": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "defuseKit": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "hasBomb": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "ammo": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "crouchAmount": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "airborne": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "walking": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "flashDurationSeconds": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "scoped": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "money": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "placeName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "input": {
