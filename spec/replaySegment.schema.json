                                "type": "string",
                                "enum": [
                                  "FORWARD",
                                  "BACK",
                                  "LEFT",
                                  "RIGHT"
                                ]
                              }
                            },
                            "jump": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "primaryFire": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "secondaryFire": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "walk": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "pinPulled": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "throwStrength": {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "null"
                                }
